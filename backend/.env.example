# PELEC Backend Environment Variables
# Copy this file to .env and fill in the values for your deployment

# ============================================================================
# SECURITY & DEBUG
# ============================================================================

# Django SECRET_KEY - MUST be changed for production!
# Generate using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Or use: https://djecrety.ir/
SECRET_KEY=django-insecure-change-this-secret-key

# Debug mode - MUST be False in production
DEBUG=False

# ============================================================================
# ALLOWED HOSTS
# ============================================================================

# Comma-separated list of domains that can access this API
# Examples: localhost,127.0.0.1,api.example.com,*.onrender.com
# For Render deployment: yourapp.onrender.com,www.yourapp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE
# ============================================================================

# Leave empty to use SQLite locally
# For production, use PostgreSQL connection string:
# postgresql://username:password@hostname:5432/dbname
# Format: postgresql://user:password@host:port/database
# Note: Use 'postgresql://', not 'postgres://'
DATABASE_URL=

# ============================================================================
# CORS & FRONTEND
# ============================================================================

# Comma-separated list of frontend domains allowed to make requests
# Examples: http://localhost:5173,https://app.example.com,https://www.example.com
# For local dev: http://localhost:5173,http://localhost:3000
# For production: https://your-vercel-app.vercel.app
FRONTEND_URLS=http://localhost:5173

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Environment identifier (used for logging, notifications, etc.)
# Values: development, staging, production
ENVIRONMENT=development

# ============================================================================
# OPTIONAL: Additional settings
# ============================================================================

# Email backend (if implementing email notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# AWS S3 (if using for media storage instead of local)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# HELPFUL NOTES
# ============================================================================

# Production Deployment (Render):
# 1. Set DEBUG=False
# 2. Generate and set unique SECRET_KEY
# 3. Set DATABASE_URL to your PostgreSQL connection string
# 4. Set ALLOWED_HOSTS to your domain(s)
# 5. Set FRONTEND_URLS to your Vercel app URL
# 6. Never commit .env file - always use .env.example as template

# Testing Locally with Production-like Settings:
# 1. Copy this file to .env
# 2. Set DEBUG=False to test static files collection
# 3. Test migrations: python manage.py migrate
# 4. Test static files: python manage.py collectstatic --noinput

